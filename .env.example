# Copia este archivo a .env (ignorado por git) y completa los valores en tu equipo.
# En GitHub Actions define los mismos nombres como "Repository secrets". Nunca escribas valores reales aquí.

# Publicación a Supabase/PostgreSQL (sin estas cinco variables el pipeline no publica y termina correctamente)
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=
SUPABASE_DB_NAME=
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=

# Opcionales de publicación
# require (Supabase) | disable (PostgreSQL local de pruebas)
SUPABASE_DB_SSLMODE=
# Esquema de destino (por defecto qqp)
QQP_PG_SCHEMA=
# Rol de solo lectura para Looker Studio al que se otorga SELECT tras cada publicación
QQP_PG_ROL_LECTURA=

# Alertas (opcional): webhook compatible con Slack, Microsoft Teams o Discord
ALERTA_WEBHOOK_URL=
# 1 = notificar solo fallas (por defecto también alertas de calidad)
ALERTA_SOLO_FALLOS=

# Recursos de DuckDB (por defecto 4 hilos y 8GB)
QQP_DUCKDB_THREADS=
QQP_DUCKDB_MEMORY_LIMIT=
